# Copy to .env (or set in your host's dashboard). Nothing here is required to run the demo.
PORT=8080
PUBLIC_URL=https://your-backend.example.com   # used in SMS tracking links
DB_PATH=./vera.db                              # use a persistent disk in production (timers survive restarts)

# AI summary + Ask VERA. Without a key the app uses the deterministic brief and offline first-aid cards.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# SMS to contacts. Without these, messages are written to the outbox table only.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Places: osm (free, no key) or google
PLACES_PROVIDER=osm
GOOGLE_PLACES_KEY=

# Where the Download APK button gets the file if public/VERA-Guard.apk is not bundled
APK_URL=https://github.com/<you>/<repo>/releases/download/latest/VERA-Guard.apk

# Test helper: expose sent SMS at /api/outbox (never in production)
# DEMO_OUTBOX=1
